<?xml version="1.0" encoding="utf-8"?>
<!--
  App manifest.
  - No INTERNET permission, ever (SPEC 1). No storage permissions: files go through the system picker.
  - POST_NOTIFICATIONS: asked at runtime (Android 13+) the first time a timer starts.
  - SCHEDULE_EXACT_ALARM: for an on-time "planned end" alert. Denied by default on Android 14+
    for new installs; the app checks and falls back to an inexact alarm (DECISIONS.md, M4).
    USE_EXACT_ALARM is not used: it is meant for alarm-clock and calendar apps.
  - allowBackup="false": the app's own backup (SPEC 8) is the only backup mechanism.
    data_extraction_rules.xml also excludes everything from device-to-device transfer.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".TttApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ttt">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Ttt"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fired by PhaseAlarmScheduler at a phase's planned end. Only this app can send it. -->
        <receiver
            android:name=".data.alarm.PhaseAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>
