<?xml version="1.0" encoding="utf-8"?>
<!--
  Window theme only (status bar, window background before Compose draws).
  All real styling is in ui/theme/*.kt. The DayNight parent avoids a white flash in dark mode.
-->
<resources>
    <style name="Theme.Ttt" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
