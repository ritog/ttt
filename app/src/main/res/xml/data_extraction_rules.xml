<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes all app data from Android cloud backup and device-to-device transfer.
  The app's own SQLite backup (SPEC 8) is the single backup mechanism in v1.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
